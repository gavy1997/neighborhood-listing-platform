{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PropertyListing",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "property_id",
    "street",
    "city",
    "state",
    "zip_code",
    "price",
    "bedrooms",
    "bathrooms",
    "square_feet",
    "amenities",
    "local_sponsors"
  ],
  "properties": {
    "property_id": {
      "type": "string",
      "format": "uuid"
    },
    "street": {
      "type": "string",
      "minLength": 1
    },
    "city": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "zip_code": {
      "type": "string",
      "pattern": "^\\d{5}(-\\d{4})?$"
    },
    "price": {
      "type": "number",
      "minimum": 0
    },
    "bedrooms": {
      "type": "integer",
      "minimum": 0
    },
    "bathrooms": {
      "type": "number",
      "minimum": 0
    },
    "square_feet": {
      "type": "integer",
      "minimum": 0
    },
    "amenities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "local_sponsors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sponsor_id", "name"],
        "properties": {
          "sponsor_id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}